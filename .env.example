# ---------------------------------------------------------------------------
# AXIOM configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Safety ----------------------------------------------------------------
# Master trading mode. One of: backtest | paper | live
# `live` additionally requires AXIOM_LIVE_TRADING_CONFIRMED=I_UNDERSTAND_THE_RISK
AXIOM_TRADING_MODE=paper
AXIOM_LIVE_TRADING_CONFIRMED=
# Hard kill switch. When true, no order may leave the router under any mode.
AXIOM_KILL_SWITCH=false

# --- Risk limits (all enforced by axiom.risk.RiskManager) ------------------
AXIOM_ACCOUNT_EQUITY=100000
AXIOM_MAX_RISK_PER_TRADE_PCT=0.5
AXIOM_DAILY_LOSS_LIMIT_PCT=2.0
AXIOM_MAX_GROSS_EXPOSURE_PCT=200
AXIOM_MAX_POSITIONS=5
AXIOM_MAX_CONSECUTIVE_LOSSES=4

# --- Execution assumptions (always applied in backtests) -------------------
AXIOM_COMMISSION_PER_UNIT=0.85
AXIOM_SLIPPAGE_TICKS=1.0

# --- AI agent layer --------------------------------------------------------
ANTHROPIC_API_KEY=
AXIOM_AGENT_MODEL=claude-opus-5

# --- Market data providers (all optional) ----------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
POLYGON_API_KEY=
DATABENTO_API_KEY=
FRED_API_KEY=
